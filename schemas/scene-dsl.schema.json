{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneDSL",
  "description": "Element-level declarative scene (ADR-014): an ordered node list — backend describes WHAT plays, the client Story Player decides HOW. Unknown future node types must be skippable by the client without backend changes.",
  "type": "object",
  "required": ["scene_id", "nodes"],
  "properties": {
    "scene_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["node_id", "type"],
      "properties": {
        "node_id": { "type": "string" },
        "type": { "type": "string", "enum": ["dialogue", "choice", "animation", "voice", "reward"] },
        "speaker": { "type": "string" },
        "text": { "type": "string" },
        "voice": { "type": "string", "description": "Fixed voice identity, e.g. 'doudou_v1'. Never voice cloning in v1." },
        "prompt": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "asset": { "type": "string", "description": "Semantic asset ref, e.g. 'character/doudou/emotion/happy'." },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "kind": { "type": "string", "description": "Reward kind, e.g. 'star', 'badge'." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "dialogue" } } },
          "then": { "required": ["speaker", "text"] }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "required": ["prompt", "options"] }
        },
        {
          "if": { "properties": { "type": { "const": "animation" } } },
          "then": { "required": ["asset"] }
        },
        {
          "if": { "properties": { "type": { "const": "voice" } } },
          "then": { "required": ["prompt"] }
        },
        {
          "if": { "properties": { "type": { "const": "reward" } } },
          "then": { "required": ["kind", "text"] }
        }
      ]
    }
  }
}
