{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionInteraction",
  "description": "A real child interaction inside a Story Player session. Every interaction references the EXACT node (node_id) it answers; choices must pick one of that node's options (validated in code against the stored session document, ADR-014).",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "node_type"],
  "properties": {
    "session_id": { "type": "string" },
    "node_id": {
      "type": "string",
      "description": "Required for choice/voice interactions — the exact Scene DSL node being answered."
    },
    "node_type": {
      "type": "string",
      "enum": ["choice", "voice", "callback_shown", "callback_recognized"]
    },
    "choice_id": {
      "type": "string",
      "description": "Required for node_type=choice; must be one of the referenced node's options."
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "Required for node_type=voice."
    },
    "moment": {
      "type": "string",
      "description": "Callback moment for callback_shown / callback_recognized."
    },
    "response": {
      "type": "string",
      "enum": ["recognized", "ignored"],
      "description": "Required for callback_recognized."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "node_type": { "const": "choice" } } },
      "then": { "required": ["node_id", "choice_id"] }
    },
    {
      "if": { "properties": { "node_type": { "const": "voice" } } },
      "then": { "required": ["node_id", "answer"] }
    },
    {
      "if": { "properties": { "node_type": { "const": "callback_recognized" } } },
      "then": { "required": ["moment", "response"] }
    },
    {
      "if": { "properties": { "node_type": { "const": "callback_shown" } } },
      "then": { "required": ["moment"] }
    }
  ]
}
