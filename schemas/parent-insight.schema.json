{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParentInsight",
  "description": "Family Growth Coach weekly output (ADR-009): moments → trends → one suggestion. Iron rules: never compare (only vs. the child's own past); every trend expands to its evidence chain; suggestions low-cost and executable. No scores, no rankings, no diagnosis.",
  "type": "object",
  "required": ["insight_id", "child_id", "period", "moments", "trends", "suggestion", "created_at"],
  "properties": {
    "insight_id": { "type": "string" },
    "child_id": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "moments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "evidence_quotes"],
        "properties": {
          "title": { "type": "string", "description": "Concrete growth moment (zh)." },
          "evidence_quotes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Verbatim quotes from the evidence stream — the trust currency."
          },
          "related_capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "direction", "interpretation", "evidence_refs"],
        "properties": {
          "capability_id": { "type": "string" },
          "direction": { "type": "string", "enum": ["up", "steady", "down"] },
          "interpretation": { "type": "string", "description": "Plain-language reading (zh), vs. the child's own past only." },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Evidence ids backing this trend — expandable chain, never a bare number."
          }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "required": ["title", "home_activity"],
      "properties": {
        "title": { "type": "string" },
        "home_activity": { "type": "string", "description": "One low-cost, executable family activity (zh), e.g. 'dinner-time chopstick sorting by color'." }
      }
    },
    "decision_trace_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
